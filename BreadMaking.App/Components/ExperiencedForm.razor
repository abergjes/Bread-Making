@using BreadMaking.App.Models
@using BreadMaking.App.Services
@inject HttpClient Http

<div class="two-panel-layout">
    <!-- Left panel: inputs -->
    <div class="input-panel">
        <div class="panel-header">
            <button class="back-btn" @onclick="OnBack">← Change experience level</button>
            <h2>Your Bake Conditions</h2>
        </div>

        <!-- Saved recipes -->
        @if (_savedRecipes.Count > 0)
        {
            <div class="input-group saved-recipes-group">
                <label class="input-label">Saved recipes</label>
                <div class="saved-recipe-chips">
                    @foreach (var r in _savedRecipes)
                    {
                        <button class="saved-recipe-chip" @onclick="() => LoadRecipe(r)" title="@r.Notes">
                            @r.Name
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Temperature -->
        <div class="input-group">
            <label class="input-label">
                Kitchen Temperature
                <span class="temp-display">@Inputs.KitchenTemperatureC.ToString("F0")°C / @CelsiusToFahrenheit(Inputs.KitchenTemperatureC).ToString("F0")°F</span>
            </label>
            <input type="range" min="15" max="32" step="0.5"
                   value="@Inputs.KitchenTemperatureC"
                   @oninput="OnTempChange"
                   class="bakery-slider" />
            <div class="slider-labels">
                <span>15°C Cool</span>
                <span>32°C Hot</span>
            </div>
            <div class="temp-zone @TempZoneClass">@TempZoneLabel</div>
        </div>

        <!-- Flour / blend -->
        <div class="input-group">
            <GrainBlendSelector
                PrimaryFlour="@Inputs.FlourType"
                PrimaryFlourChanged="@(v => { Inputs.FlourType = v; UpdateRecommendation(); })"
                SecondaryFlour="@Inputs.SecondaryFlourType"
                SecondaryFlourChanged="@(v => { Inputs.SecondaryFlourType = v; UpdateRecommendation(); })"
                PrimaryPercent="@Inputs.PrimaryFlourPercent"
                PrimaryPercentChanged="@(v => { Inputs.PrimaryFlourPercent = v; UpdateRecommendation(); })"
                IsCompact="true" />
        </div>

        <!-- Hydration -->
        <div class="input-group">
            <label class="input-label">
                Dough Hydration
                <span class="hydration-display">@Inputs.HydrationPercent%</span>
            </label>
            <input type="range" min="55" max="90" step="1"
                   value="@Inputs.HydrationPercent"
                   @oninput="OnHydrationChange"
                   class="bakery-slider" />
            <div class="slider-labels">
                <span>55% Stiff</span>
                <span>90% Very Wet</span>
            </div>
            <div class="hydration-zones">
                <span class="hz @(Inputs.HydrationPercent < 65 ? "hz-active" : "")">Low &lt;65%</span>
                <span class="hz @(Inputs.HydrationPercent >= 65 && Inputs.HydrationPercent < 75 ? "hz-active" : "")">Medium 65–74%</span>
                <span class="hz @(Inputs.HydrationPercent >= 75 ? "hz-active" : "")">High ≥75%</span>
            </div>
        </div>

        <!-- Starter -->
        <div class="input-group">
            <label class="input-label">Sourdough Starter</label>
            <div class="starter-options">
                @foreach (var activity in Enum.GetValues<StarterActivity>())
                {
                    <button class="starter-card @(Inputs.StarterActivity == activity ? "selected" : "")"
                            @onclick="@(() => { Inputs.StarterActivity = activity; UpdateRecommendation(); })">
                        <span class="starter-icon">@StarterIcon(activity)</span>
                        <span class="starter-label">@StarterLabel(activity)</span>
                    </button>
                }
            </div>
        </div>

        <!-- Flavour goal -->
        <div class="input-group">
            <label class="input-label">Flavour Goal</label>
            <div class="flavour-cards">
                <button class="flavour-card @(Inputs.FlavourGoal == FlavourGoal.MildOpenCrumb ? "selected" : "")"
                        @onclick="@(() => { Inputs.FlavourGoal = FlavourGoal.MildOpenCrumb; UpdateRecommendation(); })">
                    <span>🌬️</span>
                    <div>
                        <strong>Mild & Open Crumb</strong>
                        <small>Clean flavour, large irregular holes</small>
                    </div>
                </button>
                <button class="flavour-card @(Inputs.FlavourGoal == FlavourGoal.ComplexTangy ? "selected" : "")"
                        @onclick="@(() => { Inputs.FlavourGoal = FlavourGoal.ComplexTangy; UpdateRecommendation(); })">
                    <span>🍋</span>
                    <div>
                        <strong>Complex & Tangy</strong>
                        <small>Sour notes, deep fermented flavour</small>
                    </div>
                </button>
            </div>
        </div>

        <!-- Formula -->
        <div class="input-group">
            <label class="input-label">
                Flour Weight
                <span class="flour-display">@Inputs.TotalFlourGrams g</span>
            </label>
            <input type="range" min="300" max="2000" step="50"
                   value="@Inputs.TotalFlourGrams"
                   @oninput="OnFlourGramsChange"
                   class="bakery-slider" />
            <div class="slider-labels">
                <span>300 g</span>
                <span>2000 g</span>
            </div>
        </div>

        <div class="input-group formula-row">
            <div class="formula-field">
                <label class="input-label">Salt</label>
                <div class="formula-stepper">
                    <button class="stepper-btn" @onclick="@(() => AdjustSalt(-0.1))">−</button>
                    <span class="formula-value">@Inputs.SaltPct.ToString("F1")%</span>
                    <button class="stepper-btn" @onclick="@(() => AdjustSalt(+0.1))">+</button>
                </div>
            </div>
            <div class="formula-field">
                <label class="input-label">Inoculation</label>
                <div class="formula-stepper">
                    <button class="stepper-btn" @onclick="@(() => AdjustInoculation(-5))">−</button>
                    <span class="formula-value">@Inputs.InoculationPct.ToString("F0")%</span>
                    <button class="stepper-btn" @onclick="@(() => AdjustInoculation(+5))">+</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Right panel: recommendation + timeline + blend guide -->
    <div class="result-panel">
        <RecommendationPanel Recommendation="@_recommendation" Inputs="@Inputs" />
        <BakingTimeline Steps="@_recommendation?.Timeline" />
        <BlendingGuide BlendNote="@(_recommendation?.BlendNote ?? "")" />
    </div>
</div>

@code {
    [Parameter] public EventCallback OnBack { get; set; }
    [Inject] private BreadAdvisorService Advisor    { get; set; } = default!;
    [Inject] private CloneBakeState     CloneState  { get; set; } = default!;

    private BreadInputs Inputs { get; set; } = new() { Experience = BakerExperience.Experienced };
    private BreadRecommendation? _recommendation;
    private List<UserRecipeDto>  _savedRecipes = [];

    protected override async Task OnInitializedAsync()
    {
        var clone = CloneState.TakeAndClear();
        if (clone is not null)
        {
            if (clone.AmbientTempC.HasValue)
                Inputs.KitchenTemperatureC = clone.AmbientTempC.Value;
            Inputs.FlourType = GrainNameToFlourType(clone.GrainName);
            if (clone.HydrationPct.HasValue)
                Inputs.HydrationPercent = (int)clone.HydrationPct.Value;
            if (clone.StarterActivity.HasValue)
                Inputs.StarterActivity = (StarterActivity)clone.StarterActivity.Value;
            if (clone.TotalFlourGrams.HasValue)
                Inputs.TotalFlourGrams = (int)clone.TotalFlourGrams.Value;
            if (clone.SaltPct.HasValue)
                Inputs.SaltPct = clone.SaltPct.Value;
            if (clone.InoculationPct.HasValue)
                Inputs.InoculationPct = clone.InoculationPct.Value;
        }
        UpdateRecommendation();

        try
        {
            _savedRecipes = await Http.GetFromJsonAsync<List<UserRecipeDto>>("/api/recipes") ?? [];
        }
        catch { /* degrade silently */ }
    }

    private void LoadRecipe(UserRecipeDto r)
    {
        Inputs.FlourType        = GrainNameToFlourType(r.GrainName);
        Inputs.HydrationPercent = (int)r.HydrationPct;
        Inputs.TotalFlourGrams  = (int)r.FlourWeightG;
        Inputs.SaltPct          = r.SaltPct;
        Inputs.InoculationPct   = r.StarterPct;
        UpdateRecommendation();
    }

    private static FlourType GrainNameToFlourType(string name) => name switch
    {
        "Einkorn"           => FlourType.Einkorn,
        "Emmer (farro)"     => FlourType.Emmer,
        "Spelt"             => FlourType.Spelt,
        "Kamut (khorasan)"  => FlourType.Kamut,
        "Teff"              => FlourType.Teff,
        "Sorghum"           => FlourType.Sorghum,
        "Whole grain"       => FlourType.WholeGrain,
        "Rye"               => FlourType.Rye,
        _                   => FlourType.White,
    };

    private void OnTempChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
            Inputs.KitchenTemperatureC = v;
        UpdateRecommendation();
    }

    private void OnHydrationChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            Inputs.HydrationPercent = v;
        UpdateRecommendation();
    }

    private void OnFlourGramsChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            Inputs.TotalFlourGrams = v;
    }

    private void AdjustSalt(double delta) =>
        Inputs.SaltPct = Math.Round(Math.Clamp(Inputs.SaltPct + delta, 1.0, 3.5), 1);

    private void AdjustInoculation(double delta) =>
        Inputs.InoculationPct = Math.Clamp(Inputs.InoculationPct + delta, 5, 50);

    private void UpdateRecommendation() => _recommendation = Advisor.GetRecommendation(Inputs);

    private double CelsiusToFahrenheit(double c) => c * 9.0 / 5.0 + 32;

    private string TempZoneClass => Inputs.KitchenTemperatureC switch
    {
        < 18 => "zone-cold",
        < 22 => "zone-cool",
        < 25 => "zone-ideal",
        < 28 => "zone-warm",
        _ => "zone-hot"
    };

    private string TempZoneLabel => Inputs.KitchenTemperatureC switch
    {
        < 18 => "❄️ Very cool kitchen — extend rest times",
        < 22 => "🌥️ Cool kitchen — ideal for fermentolyse",
        < 25 => "✅ Ideal temperature range",
        < 28 => "☀️ Warm kitchen — watch fermentolyse closely",
        _ => "🔥 Hot kitchen — use autolyse or refrigerate dough"
    };

    private string StarterIcon(StarterActivity a) => a switch
    {
        StarterActivity.NotAvailable => "❌",
        StarterActivity.JustFed => "🌱",
        StarterActivity.AtPeak => "🚀",
        StarterActivity.PastPeak => "📉",
        _ => "?"
    };

    private string StarterLabel(StarterActivity a) => a switch
    {
        StarterActivity.NotAvailable => "No starter",
        StarterActivity.JustFed => "Just fed",
        StarterActivity.AtPeak => "At peak",
        StarterActivity.PastPeak => "Past peak",
        _ => a.ToString()
    };
}
