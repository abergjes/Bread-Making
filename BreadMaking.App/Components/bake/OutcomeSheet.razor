@* Bottom-sheet for recording bake outcome metrics. *@
@inject HttpClient Http

@if (IsVisible)
{
    <div class="ms-overlay" @onclick="HandleBackdropClick">
        <div class="ms-sheet os-sheet" @onclick:stopPropagation="true">

            <div class="ms-handle"></div>

            <div class="ms-header">
                <h3 class="ms-title">Log outcome</h3>
                <p class="ms-subtitle">Record measurements and scores after the bake</p>
            </div>

            <div class="os-fields">

                <div class="os-group-label">PHOTO</div>

                <div class="os-photo-row">
                    @if (_photoPreviewUrl is not null)
                    {
                        <img src="@_photoPreviewUrl" class="os-photo-thumb" alt="Selected photo" />
                    }
                    else if (ExistingOutcome?.PhotoPath is not null)
                    {
                        <img src="/uploads/@ExistingOutcome.PhotoPath" class="os-photo-thumb" alt="Bake photo" />
                    }
                    <label class="os-photo-btn">
                        📷 @PhotoBtnLabel
                        <InputFile OnChange="HandlePhotoSelected" accept="image/*" style="display:none" />
                    </label>
                </div>

                <div class="os-group-label" style="margin-top:8px">MEASUREMENTS</div>

                <OutcomeField Label="Loaf height" Unit="cm"
                              Value="_loafHeight" ValueChanged="v => _loafHeight = v"
                              Step="0.5" Format="F1" DefaultValue="10.0" />
                <OutcomeField Label="Oven spring" Unit="%"
                              Value="_ovenSpring" ValueChanged="v => _ovenSpring = v"
                              Step="1" Format="F0" DefaultValue="20.0" />
                <OutcomeField Label="Weight loss" Unit="%"
                              Value="_weightLoss" ValueChanged="v => _weightLoss = v"
                              Step="0.1" Format="F1" DefaultValue="12.0" />
                <OutcomeField Label="Internal temp" Unit="°C"
                              Value="_internalTemp" ValueChanged="v => _internalTemp = v"
                              Step="0.5" Format="F1" DefaultValue="95.0" />

                <div class="os-group-label" style="margin-top:8px">SCORES (0–10)</div>

                <OutcomeField Label="Crumb openness" Unit="/10"
                              Value="@(_crumbOpenness.HasValue ? (double)_crumbOpenness.Value : (double?)null)"
                              ValueChanged="v => _crumbOpenness = v.HasValue ? (int)Math.Round(v.Value) : null"
                              Step="1" Format="F0" Min="0" Max="10" IsInteger="true" />
                <OutcomeField Label="Crust" Unit="/10"
                              Value="@(_crustScore.HasValue ? (double)_crustScore.Value : (double?)null)"
                              ValueChanged="v => _crustScore = v.HasValue ? (int)Math.Round(v.Value) : null"
                              Step="1" Format="F0" Min="0" Max="10" IsInteger="true" />
                <OutcomeField Label="Taste" Unit="/10"
                              Value="@(_tasteScore.HasValue ? (double)_tasteScore.Value : (double?)null)"
                              ValueChanged="v => _tasteScore = v.HasValue ? (int)Math.Round(v.Value) : null"
                              Step="1" Format="F0" Min="0" Max="10" IsInteger="true" />

            </div>

            @if (_error is not null)
            {
                <p class="os-error">@_error</p>
            }

            <div class="ms-actions">
                <button class="ms-btn ms-btn-cancel" @onclick="Cancel">Cancel</button>
                <button class="ms-btn ms-btn-save @(_saving ? "ms-btn-loading" : "")"
                        disabled="@_saving"
                        @onclick="Save">
                    @(_saving ? "Saving…" : "Save outcome")
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int              BakeId          { get; set; }
    [Parameter]                 public BakeOutcomeDto?  ExistingOutcome { get; set; }
    [Parameter]                 public bool             IsVisible       { get; set; }
    [Parameter]                 public EventCallback    OnSaved         { get; set; }
    [Parameter]                 public EventCallback    OnCancelled     { get; set; }

    private double?       _loafHeight;
    private double?       _ovenSpring;
    private double?       _weightLoss;
    private double?       _internalTemp;
    private int?          _crumbOpenness;
    private int?          _crustScore;
    private int?          _tasteScore;
    private IBrowserFile? _pendingPhoto;
    private string?       _photoPreviewUrl;
    private bool          _saving;
    private string?       _error;

    private string PhotoBtnLabel =>
        _pendingPhoto is not null           ? "Change photo"  :
        ExistingOutcome?.PhotoPath is not null ? "Replace photo" :
                                              "Add photo";

    protected override void OnParametersSet()
    {
        if (!IsVisible) return;
        _loafHeight      = ExistingOutcome?.LoafHeightCm;
        _ovenSpring      = ExistingOutcome?.OvenSpringPct;
        _weightLoss      = ExistingOutcome?.WeightLossPct;
        _internalTemp    = ExistingOutcome?.InternalTempC;
        _crumbOpenness   = ExistingOutcome?.CrumbOpenness;
        _crustScore      = ExistingOutcome?.CrustScore;
        _tasteScore      = ExistingOutcome?.TasteScore;
        _pendingPhoto    = null;
        _photoPreviewUrl = null;
        _error           = null;
    }

    private async Task HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        _pendingPhoto = e.File;
        // Resize to a preview thumbnail (max 400×400) to avoid reading a multi-MB image as base64
        var preview = await e.File.RequestImageFileAsync("image/jpeg", 400, 400);
        using var ms = new MemoryStream();
        await preview.OpenReadStream(maxAllowedSize: 1024 * 1024).CopyToAsync(ms);
        _photoPreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task Save()
    {
        _saving = true;
        _error  = null;

        // 1. Save outcome fields
        var dto = new BakeOutcomeDto
        {
            LoafHeightCm  = _loafHeight,
            OvenSpringPct = _ovenSpring,
            WeightLossPct = _weightLoss,
            InternalTempC = _internalTemp,
            CrumbOpenness = _crumbOpenness,
            CrustScore    = _crustScore,
            TasteScore    = _tasteScore,
        };

        var resp = await Http.PutAsJsonAsync($"/api/bakes/{BakeId}/outcome", dto);
        if (!resp.IsSuccessStatusCode)
        {
            _error  = $"Could not save outcome ({(int)resp.StatusCode}). Please try again.";
            _saving = false;
            return;
        }

        // 2. Upload photo if one was selected
        if (_pendingPhoto is not null)
        {
            using var content     = new MultipartFormDataContent();
            var       fileStream  = _pendingPhoto.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var       fileContent = new StreamContent(fileStream);
            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(_pendingPhoto.ContentType);
            content.Add(fileContent, "photo", _pendingPhoto.Name);

            var photoResp = await Http.PostAsync($"/api/bakes/{BakeId}/outcome/photo", content);
            if (!photoResp.IsSuccessStatusCode)
            {
                _error  = "Outcome saved but photo upload failed. You can re-open and try again.";
                _saving = false;
                await OnSaved.InvokeAsync(); // outcome fields were saved successfully
                return;
            }
        }

        _saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Cancel()             => await OnCancelled.InvokeAsync();
    private async Task HandleBackdropClick() => await OnCancelled.InvokeAsync();
}
