@using BreadMaking.App.Models

<div class="wizard-step">
    <div class="step-explain">
        <h3>🌡️ What's your kitchen temperature?</h3>
        <div class="explain-box">
            <p><strong>Why it matters:</strong> Temperature is the single most important variable in bread making. Warmth accelerates enzyme activity and — if you're using a sourdough starter — speeds up fermentation. A warm kitchen can turn a 90-minute rest into a 45-minute one.</p>
            <p><strong>What to do:</strong> Use a kitchen thermometer or check your thermostat. If you don't know, 20–22°C is a reasonable assumption for a typical home kitchen.</p>
        </div>
    </div>

    <div class="step-input">
        <div class="temp-display-large">
            @Value.ToString("F0")°C &nbsp;/&nbsp; @((Value * 9.0 / 5.0 + 32).ToString("F0"))°F
        </div>
        <input type="range" min="15" max="32" step="0.5"
               value="@Value"
               @oninput="OnChange"
               class="bakery-slider slider-large" />
        <div class="slider-labels">
            <span>15°C — Very Cool</span>
            <span>32°C — Hot</span>
        </div>
        <div class="temp-zone @ZoneClass">@ZoneLabel</div>
    </div>
</div>

@code {
    [Parameter] public double Value { get; set; } = 22;
    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    private void OnChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
            ValueChanged.InvokeAsync(v);
    }

    private string ZoneClass => Value switch
    {
        < 18 => "zone-cold",
        < 22 => "zone-cool",
        < 25 => "zone-ideal",
        < 28 => "zone-warm",
        _ => "zone-hot"
    };

    private string ZoneLabel => Value switch
    {
        < 18 => "❄️ Very cool — fermentation will be very slow. Extend all rest times.",
        < 22 => "🌥️ Cool kitchen — great for controlled fermentolyse.",
        < 25 => "✅ Ideal baking temperature.",
        < 28 => "☀️ Warm — keep rest times shorter to avoid over-fermentation.",
        _ => "🔥 Hot kitchen — use cold water and keep all rests brief."
    };
}
