@using BreadMaking.App.Models
@inject HttpClient Http
@inject NavigationManager Nav
@using BreadMaking.App.Shared.Dtos

@if (Recommendation is null)
{
    <div class="recommendation-empty">
        <div class="empty-icon">🌾</div>
        <p>Fill in your conditions and your recommendation will appear here.</p>
    </div>
}
else
{
    <div class="recommendation @MethodClass">
        <div class="rec-badge">
            <span class="rec-icon">@MethodIcon</span>
            <div>
                <div class="rec-headline">@Recommendation.Headline</div>
                @if (Recommendation.Method == RestMethod.Soaker)
                {
                    <div class="rec-duration">Soaker rest for <strong>@Recommendation.RestDurationSweetSpot minutes</strong></div>
                }
                else if (Recommendation.Method != RestMethod.Skip)
                {
                    @if (Recommendation.RestDurationMin < Recommendation.RestDurationMax)
                    {
                        <div class="rec-duration">
                            Rest: <strong>@Recommendation.RestDurationMin–@Recommendation.RestDurationMax min</strong>
                            <span class="rec-sweet-spot">(aim for ~@Recommendation.RestDurationSweetSpot min)</span>
                        </div>
                    }
                    else
                    {
                        <div class="rec-duration">Rest for <strong>@Recommendation.RestDurationSweetSpot minutes</strong></div>
                    }
                }
            </div>
        </div>

        <p class="rec-reason">@Recommendation.Reason</p>

        @if (Recommendation.Method != RestMethod.Skip && !string.IsNullOrEmpty(Recommendation.RiskLevel))
        {
            <div class="risk-badge risk-@RiskClass">
                Risk level: <strong>@Recommendation.RiskLevel</strong>
            </div>
        }

        @if (Recommendation.Pros.Any() || Recommendation.Cons.Any())
        {
            <div class="rec-pros-cons">
                @if (Recommendation.Pros.Any())
                {
                    <div class="pros-col">
                        <h4>Pros</h4>
                        <ul>
                            @foreach (var pro in Recommendation.Pros)
                            {
                                <li class="pro-item">@pro</li>
                            }
                        </ul>
                    </div>
                }
                @if (Recommendation.Cons.Any())
                {
                    <div class="cons-col">
                        <h4>Cons</h4>
                        <ul>
                            @foreach (var con in Recommendation.Cons)
                            {
                                <li class="con-item">@con</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        @if (Recommendation.Tips.Any())
        {
            <div class="rec-tips">
                <h4>Key tips for this bake</h4>
                <ul>
                    @foreach (var tip in Recommendation.Tips)
                    {
                        <li>@tip</li>
                    }
                </ul>
            </div>
        }

        @if (Inputs is not null)
        {
            <div class="start-bake-section">
                @if (_recentFeeds.Count > 0)
                {
                    <div class="starter-feed-selector">
                        <label class="starter-feed-label">Link starter feed (optional)</label>
                        <select class="starter-feed-select" @bind="_linkedFeedId">
                            <option value="">— No link —</option>
                            @foreach (var feed in _recentFeeds)
                            {
                                <option value="@feed.Id">
                                    @feed.StarterName · @FormatFeedAge(feed.FedAt)
                                </option>
                            }
                        </select>
                    </div>
                }
                <button class="btn-start-bake @(_starting ? "btn-loading" : "")"
                        disabled="@_starting"
                        @onclick="StartBake">
                    @(_starting ? "Starting…" : "Start Bake ▶")
                </button>
                <p class="start-bake-hint">Records your actual durations and measurements</p>

                @if (!_showSaveRecipe && _savedStatus is null)
                {
                    <button class="btn-save-recipe" @onclick="() => { _showSaveRecipe = true; _recipeName = DefaultRecipeName(); }">
                        📌 Save as recipe
                    </button>
                }
                @if (_showSaveRecipe)
                {
                    <div class="save-recipe-row">
                        <input class="save-recipe-input" placeholder="Recipe name"
                               @bind="_recipeName" @bind:event="oninput" maxlength="80" />
                        <button class="btn-save-recipe-confirm @(_saving ? "btn-loading" : "")"
                                disabled="@(_saving || string.IsNullOrWhiteSpace(_recipeName))"
                                @onclick="SaveRecipe">
                            @(_saving ? "Saving…" : "Save")
                        </button>
                        <button class="btn-save-recipe-cancel" @onclick="() => _showSaveRecipe = false">✕</button>
                    </div>
                }
                @if (_savedStatus is not null)
                {
                    <p class="save-recipe-status">@_savedStatus</p>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public BreadRecommendation? Recommendation { get; set; }
    [Parameter] public BreadInputs?         Inputs         { get; set; }

    private bool   _starting;
    private List<StarterFeedLogDto> _recentFeeds = [];
    private string _linkedFeedId = "";

    // Save-as-recipe state (M14)
    private bool    _showSaveRecipe;
    private bool    _saving;
    private string  _recipeName     = "";
    private string? _savedStatus;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _recentFeeds = await Http.GetFromJsonAsync<List<StarterFeedLogDto>>(
                "/api/starters/recent-feeds?count=5") ?? [];
        }
        catch { /* starters not set up yet — degrade silently */ }
    }

    private async Task StartBake()
    {
        if (Recommendation is null || Inputs is null) return;
        _starting = true;

        var req = new StartBakeRequest
        {
            GrainName        = ToGrainName(Inputs.DominantFlourType),
            Method           = ToMethodName(Recommendation.Method),
            AmbientTempC     = Inputs.KitchenTemperatureC,
            HydrationPct     = Inputs.HydrationPercent,
            StarterActivity  = (int)Inputs.StarterActivity,
            TotalFlourGrams  = Inputs.TotalFlourGrams,
            SaltPct          = Inputs.SaltPct,
            InoculationPct   = Inputs.InoculationPct,
            StarterFeedLogId = int.TryParse(_linkedFeedId, out var fid) ? fid : null,
        };

        var response = await Http.PostAsJsonAsync("/api/bakes", req);
        if (response.IsSuccessStatusCode)
        {
            var dto = await response.Content.ReadFromJsonAsync<BakeDto>();
            if (dto is not null)
            {
                Nav.NavigateTo($"/bake/{dto.Id}");
                return;
            }
        }
        _starting = false;
    }

    private static string ToGrainName(FlourType flour) => flour switch
    {
        FlourType.White     => "Modern wheat",
        FlourType.WholeGrain => "Whole grain",
        FlourType.Rye       => "Rye",
        FlourType.Spelt     => "Spelt",
        FlourType.Einkorn   => "Einkorn",
        FlourType.Emmer     => "Emmer (farro)",
        FlourType.Kamut     => "Kamut (khorasan)",
        FlourType.Teff      => "Teff",
        FlourType.Sorghum   => "Sorghum",
        _                   => "Modern wheat",
    };

    private static string ToMethodName(RestMethod method) => method switch
    {
        RestMethod.Fermentolyse => "Fermentolyse",
        RestMethod.Soaker       => "Other",
        _                       => "Autolyse",
    };

    private string MethodClass => Recommendation?.Method switch
    {
        RestMethod.Autolyse => "method-autolyse",
        RestMethod.Fermentolyse => "method-fermentolyse",
        RestMethod.Skip => "method-skip",
        RestMethod.Soaker => "method-soaker",
        _ => ""
    };

    private string MethodIcon => Recommendation?.Method switch
    {
        RestMethod.Autolyse => "💧",
        RestMethod.Fermentolyse => "🌡️",
        RestMethod.Skip => "⏩",
        RestMethod.Soaker => "🫙",
        _ => "🍞"
    };

    private string RiskClass => Recommendation?.RiskLevel?.ToLower().Replace(" ", "-") ?? "";

    private static string FormatFeedAge(DateTimeOffset fedAt)
    {
        var hours = (DateTimeOffset.UtcNow - fedAt).TotalHours;
        if (hours < 1)   return "just fed";
        if (hours < 24)  return $"{(int)hours}h ago";
        return $"{(int)(hours / 24)}d ago";
    }

    private string DefaultRecipeName()
    {
        if (Inputs is null || Recommendation is null) return "";
        var grain  = ToGrainName(Inputs.DominantFlourType);
        var method = ToMethodName(Recommendation.Method);
        return $"{grain} — {method} {Inputs.HydrationPercent}%";
    }

    private async Task SaveRecipe()
    {
        if (Inputs is null || Recommendation is null || string.IsNullOrWhiteSpace(_recipeName)) return;
        _saving = true;

        var req = new SaveRecipeRequest
        {
            Name         = _recipeName.Trim(),
            GrainName    = ToGrainName(Inputs.DominantFlourType),
            Method       = ToMethodName(Recommendation.Method),
            HydrationPct = Inputs.HydrationPercent,
            FlourWeightG = Inputs.TotalFlourGrams,
            SaltPct      = Inputs.SaltPct,
            StarterPct   = Inputs.InoculationPct,
        };

        var response = await Http.PostAsJsonAsync("/api/recipes", req);
        _saving = false;
        _showSaveRecipe = false;
        _savedStatus = response.IsSuccessStatusCode ? "✅ Recipe saved" : "❌ Save failed";
    }
}
