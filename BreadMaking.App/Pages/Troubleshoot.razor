@page "/troubleshoot"
@inject NavigationManager Nav

<div class="troubleshoot-page">

    <div class="troubleshoot-header">
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/history")'>← History</button>
        <div class="troubleshoot-title-group">
            <h2 class="troubleshoot-title">Sourdough Troubleshooting</h2>
            <p class="troubleshoot-subtitle">Diagnose common problems by symptom — crumb, crust, shape, fermentation</p>
        </div>
    </div>

    <!-- Symptom search -->
    <div class="troubleshoot-search-row">
        <input class="troubleshoot-search" type="search" placeholder="Filter by symptom or cause…"
               @bind="_filter" @bind:event="oninput" />
    </div>

    <div class="troubleshoot-categories">
        <button class="troubleshoot-cat @(_activeCat == "" ? "active" : "")" @onclick='() => _activeCat = ""'>All</button>
        @foreach (var cat in _categories)
        {
            <button class="troubleshoot-cat @(_activeCat == cat ? "active" : "")"
                    @onclick="() => _activeCat = cat">
                @cat
            </button>
        }
    </div>

    <div class="troubleshoot-list">
        @foreach (var p in FilteredProblems)
        {
            <div class="trouble-card" id="@p.Id">
                <button class="trouble-card-header"
                        @onclick="() => ToggleExpanded(p.Id)">
                    <div class="trouble-left">
                        <span class="trouble-severity trouble-severity--@p.SeverityClass">@p.Severity</span>
                        <span class="trouble-icon">@p.Icon</span>
                        <div class="trouble-titles">
                            <div class="trouble-symptom">@p.Symptom</div>
                            <div class="trouble-cat-badge">@p.Category</div>
                        </div>
                    </div>
                    <span class="trouble-chevron">@(_expanded.Contains(p.Id) ? "▲" : "▼")</span>
                </button>
                @if (_expanded.Contains(p.Id))
                {
                    <div class="trouble-body">
                        <div class="trouble-causes-section">
                            <div class="trouble-causes-label">Most likely causes</div>
                            @foreach (var cause in p.Causes)
                            {
                                <div class="trouble-cause">
                                    <span class="trouble-cause-icon">⚠</span>
                                    <span>@cause</span>
                                </div>
                            }
                        </div>
                        <div class="trouble-fixes-section">
                            <div class="trouble-fixes-label">How to fix / prevent</div>
                            @foreach (var fix in p.Fixes)
                            {
                                <div class="trouble-fix">
                                    <span class="trouble-fix-icon">✓</span>
                                    <span>@fix</span>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(p.Explanation))
                        {
                            <p class="trouble-explanation">@p.Explanation</p>
                        }
                    </div>
                }
            </div>
        }
        @if (!FilteredProblems.Any())
        {
            <p class="troubleshoot-empty">No problems match "@_filter" — try a different symptom or clear the filter.</p>
        }
    </div>

</div>

@code {
    private string _filter    = "";
    private string _activeCat = "";
    private readonly HashSet<string> _expanded = [];

    private void ToggleExpanded(string id)
    {
        if (!_expanded.Add(id)) _expanded.Remove(id);
    }

    private record Problem(string Id, string Icon, string Symptom, string Category, string Severity, string SeverityClass,
        string[] Causes, string[] Fixes, string Explanation);

    private string[] _categories => _problems.Select(p => p.Category).Distinct().ToArray();

    private IEnumerable<Problem> FilteredProblems => _problems
        .Where(p => string.IsNullOrEmpty(_activeCat) || p.Category == _activeCat)
        .Where(p => string.IsNullOrEmpty(_filter) ||
                    p.Symptom.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                    p.Category.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                    p.Causes.Any(c => c.Contains(_filter, StringComparison.OrdinalIgnoreCase)) ||
                    p.Fixes.Any(f => f.Contains(_filter, StringComparison.OrdinalIgnoreCase)));

