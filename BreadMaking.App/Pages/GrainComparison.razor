@page "/history/compare"
@inject HttpClient Http
@inject NavigationManager Nav
@using BreadMaking.App.Shared.Dtos
@using BreadMaking.App.Shared

<div class="comparison-page">

    <div class="comparison-header">
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/history")'>← History</button>
        <div>
            <h2 class="comparison-title">Grain comparison</h2>
            <p class="comparison-subtitle">Average outcomes across all logged bakes, by grain</p>
        </div>
    </div>

    @if (_loading)
    {
        <p class="comparison-loading">Loading…</p>
    }
    else if (_data.Count == 0)
    {
        <div class="comparison-empty">
            <p>No bake outcomes recorded yet. Finish a bake and log its outcome to see grain comparisons here.</p>
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/")'>Go to advisor</button>
        </div>
    }
    else
    {
        <div class="comparison-charts">

            <div class="comparison-panel">
                <h3 class="panel-title">Oven spring</h3>
                <ApexChart TItem="GrainBar" Options="_ovenOptions" Height="320">
                    <ApexPointSeries TItem="GrainBar"
                        Items="_ovenBars"
                        Name="Oven spring %"
                        SeriesType="SeriesType.Bar"
                        XValue="@(b => b.Name)"
                        YValue="@(b => b.Value)" />
                </ApexChart>
            </div>

            <div class="comparison-panel">
                <h3 class="panel-title">Crumb openness</h3>
                <ApexChart TItem="GrainBar" Options="_crumbOptions" Height="320">
                    <ApexPointSeries TItem="GrainBar"
                        Items="_crumbBars"
                        Name="Crumb openness"
                        SeriesType="SeriesType.Bar"
                        XValue="@(b => b.Name)"
                        YValue="@(b => b.Value)" />
                </ApexChart>
            </div>

            <div class="comparison-panel">
                <h3 class="panel-title">Time to 50% rise</h3>
                <ApexChart TItem="GrainBar" Options="_timeOptions" Height="320">
                    <ApexPointSeries TItem="GrainBar"
                        Items="_timeBars"
                        Name="Hours to 50% rise"
                        SeriesType="SeriesType.Bar"
                        XValue="@(b => b.Name)"
                        YValue="@(b => b.Value)" />
                </ApexChart>
            </div>

        </div>

        <p class="comparison-legend-note">
            Grey bars = fewer than 3 bakes recorded — log more bakes to see comparison data.
        </p>
    }

    <div class="diff-section">
        <h3 class="grain-profiles-heading">Bake diff</h3>
        <p class="grain-profiles-subtitle">Select two bakes to compare inputs and outcomes side-by-side</p>

        @if (_bakeList.Count < 2)
        {
            <p class="analytics-empty">Log at least two bakes to use the diff tool.</p>
        }
        else
        {
            <div class="diff-selectors">
                <select class="filter-select" @bind="_diffIdA" @bind:after="LoadDiff">
                    <option value="0">— Bake A —</option>
                    @foreach (var b in _bakeList)
                    {
                        <option value="@b.Id">@b.StartedAt.ToLocalTime().ToString("d MMM yyyy") · @b.GrainName</option>
                    }
                </select>
                <span class="diff-vs">vs</span>
                <select class="filter-select" @bind="_diffIdB" @bind:after="LoadDiff">
                    <option value="0">— Bake B —</option>
                    @foreach (var b in _bakeList)
                    {
                        <option value="@b.Id">@b.StartedAt.ToLocalTime().ToString("d MMM yyyy") · @b.GrainName</option>
                    }
                </select>
            </div>

            @if (_diffLoading)
            {
                <p class="comparison-loading">Loading diff…</p>
            }
            else if (_diffA is not null && _diffB is not null)
            {
                <div class="diff-table-wrap">
                    <table class="diff-table">
                        <thead>
                            <tr>
                                <th class="diff-field-col">Field</th>
                                <th>Bake @_diffA.BakeId <span class="diff-date">@_diffA.Date</span></th>
                                <th>Bake @_diffB.BakeId <span class="diff-date">@_diffB.Date</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @DiffRow("Grain",        _diffA.GrainName,      _diffB.GrainName)
                            @DiffRow("Method",       _diffA.Method,         _diffB.Method)
                            @DiffRowF("Hydration %", _diffA.HydrationPct,   _diffB.HydrationPct,  "F1")
                            @DiffRowF("Salt %",      _diffA.SaltPct,        _diffB.SaltPct,       "F2")
                            @DiffRowF("Inoculation %", _diffA.InoculationPct, _diffB.InoculationPct, "F1")
                            @DiffRow("Starter",      StarterLabel(_diffA.StarterActivity), StarterLabel(_diffB.StarterActivity))
                            @DiffRowF("Kitchen temp °C", _diffA.AmbientTempC, _diffB.AmbientTempC, "F1")
                            @DiffRowF("Oven spring %",   _diffA.OvenSpringPct,  _diffB.OvenSpringPct,  "F0")
                            @DiffRowI("Crumb openness",  _diffA.CrumbOpenness,  _diffB.CrumbOpenness,  "/10")
                            @DiffRowI("Overall score",   _diffA.OverallScore,   _diffB.OverallScore,   "★")
                            @DiffRowI("Taste",           _diffA.TasteScore,     _diffB.TasteScore,     "/10")
                            @DiffRowI("Crust",           _diffA.CrustScore,     _diffB.CrustScore,     "/10")
                            @DiffRow("Proofing",     ProofingLabel(_diffA.ProofingResult), ProofingLabel(_diffB.ProofingResult))
                            @DiffRow("Tags",         _diffA.Tags ?? "—",    _diffB.Tags ?? "—")
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    @if (_profiles.Count > 0)
    {
        <div class="grain-profiles-section">
            <h3 class="grain-profiles-heading">Grain encyclopedia</h3>
            <p class="grain-profiles-subtitle">Tap a card to expand details</p>

            <div class="grain-profile-grid">
                @foreach (var p in _profiles)
                {
                    var pid = p.Id;
                    <div class="grain-profile-card @(_expandedId == pid ? "grain-profile-card-open" : "")"
                         @onclick="() => _expandedId = (_expandedId == pid ? (int?)null : pid)">

                        <div class="grain-profile-card-header">
                            <span class="grain-profile-name">@p.Name</span>
                            <div class="grain-profile-tags">
                                @if (!string.IsNullOrEmpty(p.Ploidy))
                                {
                                    <span class="grain-tag grain-tag-ploidy">@p.Ploidy</span>
                                }
                                <span class="grain-tag grain-tag-gluten">@p.GlutenStrength</span>
                                @if (p.NeedsBinder)
                                {
                                    <span class="grain-tag grain-tag-binder">needs binder</span>
                                }
                            </div>
                            <span class="grain-profile-chevron">@(_expandedId == pid ? "▲" : "▼")</span>
                        </div>

                        @if (_expandedId == pid)
                        {
                            <div class="grain-profile-body">
                                @if (!string.IsNullOrEmpty(p.FlavorNotes))
                                {
                                    <div class="grain-profile-row">
                                        <span class="grain-profile-label">Flavour</span>
                                        <span class="grain-profile-value">@p.FlavorNotes</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(p.NutritionHighlights))
                                {
                                    <div class="grain-profile-row">
                                        <span class="grain-profile-label">Nutrition</span>
                                        <span class="grain-profile-value">@p.NutritionHighlights</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(p.UsageNotes))
                                {
                                    <div class="grain-profile-row">
                                        <span class="grain-profile-label">Usage</span>
                                        <span class="grain-profile-value">@p.UsageNotes</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(p.HistoricalOrigin))
                                {
                                    <div class="grain-profile-row">
                                        <span class="grain-profile-label">Origin</span>
                                        <span class="grain-profile-value">@p.HistoricalOrigin</span>
                                    </div>
                                }
                            </div>
                        }

                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private bool _loading = true;
    private List<GrainComparisonDto> _data     = [];
    private List<GrainProfileDto>    _profiles  = [];
    private int?                     _expandedId;

    // Bake diff (M15)
    private List<BakeListItemDto> _bakeList   = [];
    private int                   _diffIdA;
    private int                   _diffIdB;
    private bool                  _diffLoading;
    private BakeDiffSideDto?      _diffA;
    private BakeDiffSideDto?      _diffB;

    private record GrainBar(string Name, decimal Value, bool IsPlaceholder);

    private List<GrainBar> _ovenBars  = [];
    private List<GrainBar> _crumbBars = [];
    private List<GrainBar> _timeBars  = [];

    private ApexChartOptions<GrainBar> _ovenOptions  = null!;
    private ApexChartOptions<GrainBar> _crumbOptions = null!;
    private ApexChartOptions<GrainBar> _timeOptions  = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var compTask     = Http.GetFromJsonAsync<List<GrainComparisonDto>>("/api/grains/comparison");
            var profilesTask = Http.GetFromJsonAsync<List<GrainProfileDto>>("/api/grains/profiles");
            var bakesTask    = Http.GetFromJsonAsync<List<BakeListItemDto>>("/api/bakes");
            await Task.WhenAll(compTask, profilesTask, bakesTask);
            _data     = compTask.Result     ?? [];
            _profiles = profilesTask.Result ?? [];
            _bakeList = (bakesTask.Result   ?? [])
                .OrderByDescending(b => b.StartedAt)
                .ToList();
            BuildChartData();
        }
        finally { _loading = false; }
    }

    private async Task LoadDiff()
    {
        if (_diffIdA == 0 || _diffIdB == 0 || _diffIdA == _diffIdB) return;
        _diffLoading = true;
        StateHasChanged();
        var sides = await Http.GetFromJsonAsync<BakeDiffSideDto[]>(
            $"/api/analytics/bake-diff?a={_diffIdA}&b={_diffIdB}");
        if (sides is { Length: 2 })
        {
            _diffA = sides[0];
            _diffB = sides[1];
        }
        _diffLoading = false;
    }

    private void BuildChartData()
    {
        _ovenBars  = BuildBars(_data, d => d.AvgOvenSpringPct,          placeholderHeight: 5m);
        _crumbBars = BuildBars(_data, d => d.AvgCrumbOpenness,           placeholderHeight: 0.5m);
        _timeBars  = BuildBars(_data, d => d.AvgTimeTo50PctRiseHours,    placeholderHeight: 0.2m);

        _ovenOptions  = MakeOptions("#c2651a", "% height gain", yMax: null, _ovenBars);
        _crumbOptions = MakeOptions("#4a7c59", "Score (0–10)",  yMax: 10.0, _crumbBars);
        _timeOptions  = MakeOptions("#7a9cb0", "Hours",         yMax: null, _timeBars);
    }

    private static List<GrainBar> BuildBars(
        List<GrainComparisonDto> data,
        Func<GrainComparisonDto, double?> selector,
        decimal placeholderHeight) =>
        data.Select(d =>
        {
            var metric  = selector(d);
            bool isReal = d.BakeCount >= 3 && metric.HasValue;
            return new GrainBar(
                d.GrainName,
                isReal ? (decimal)metric!.Value : placeholderHeight,
                IsPlaceholder: !isReal);
        }).ToList();

    private static ApexChartOptions<GrainBar> MakeOptions(
        string color,
        string yLabel,
        double? yMax,
        List<GrainBar> bars) =>
        new()
        {
            Chart = new Chart
            {
                Background = "transparent",
                Toolbar    = new Toolbar { Show = false },
            },
            Colors = bars.Select(b => b.IsPlaceholder ? "#d0cfc9" : color).ToList(),
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal   = false,
                    Distributed  = true,
                    BorderRadius = 4,
                }
            },
            DataLabels = new DataLabels { Enabled = false },
            Grid = new Grid { Show = true, BorderColor = "#e0c9a8", StrokeDashArray = 3 },
            Legend = new Legend { Show = false },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Yaxis =
            [
                new YAxis
                {
                    Title           = new AxisTitle { Text = yLabel },
                    Min             = 0,
                    Max             = yMax,
                    DecimalsInFloat = 1,
                }
            ],
        };

    // Diff table helpers
    private RenderFragment DiffRow(string field, string? a, string? b)
    {
        bool changed = !string.Equals(a ?? "", b ?? "", StringComparison.OrdinalIgnoreCase);
        return @<tr class="@(changed ? "diff-row-changed" : "")">
            <td class="diff-field">@field</td>
            <td>@(a ?? "—")</td>
            <td>@(b ?? "—")</td>
        </tr>;
    }

    private RenderFragment DiffRowF(string field, double? a, double? b, string fmt)
    {
        string sa = a.HasValue ? a.Value.ToString(fmt) : "—";
        string sb = b.HasValue ? b.Value.ToString(fmt) : "—";
        bool changed = sa != sb;
        return @<tr class="@(changed ? "diff-row-changed" : "")">
            <td class="diff-field">@field</td>
            <td>@sa</td>
            <td>@sb</td>
        </tr>;
    }

    private RenderFragment DiffRowI(string field, int? a, int? b, string suffix)
    {
        string sa = a.HasValue ? a.Value + suffix : "—";
        string sb = b.HasValue ? b.Value + suffix : "—";
        bool changed = sa != sb;
        return @<tr class="@(changed ? "diff-row-changed" : "")">
            <td class="diff-field">@field</td>
            <td>@sa</td>
            <td>@sb</td>
        </tr>;
    }

    private static string? StarterLabel(int? activity) => activity switch
    {
        1 => "Just fed",
        2 => "At peak",
        3 => "Past peak",
        _ => null,
    };

    private static string? ProofingLabel(int? result) => result switch
    {
        1 => "Under-proofed",
        2 => "Properly proofed",
        3 => "Over-proofed",
        _ => null,
    };
}
