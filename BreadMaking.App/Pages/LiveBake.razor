@page "/bake/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

@if (_loading)
{
    <div class="loading-screen">
        <div class="loading-icon">🍞</div>
        <p>Loading bake…</p>
    </div>
}
else if (_bake is null)
{
    <div class="live-bake-page">
        <p class="text-muted">Bake not found.</p>
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/")'>← Back to advisor</button>
    </div>
}
else
{
    <div class="live-bake-page">

        <div class="live-bake-header">
            <button class="back-btn" @onclick='() => Nav.NavigateTo("/")'>← Home</button>
            <button class="back-btn" style="margin-left:auto" @onclick='() => Nav.NavigateTo("/history")'>History →</button>
            <div class="sound-toggle">
                <label class="sound-opt @(_soundEnabled ? "sound-opt-active" : "")">
                    <input type="radio" name="sound-@Id" @onchange="() => _soundEnabled = true"
                           checked="@_soundEnabled" /> 🔔
                </label>
                <label class="sound-opt @(!_soundEnabled ? "sound-opt-active" : "")">
                    <input type="radio" name="sound-@Id" @onchange="() => _soundEnabled = false"
                           checked="@(!_soundEnabled)" /> 🔕
                </label>
            </div>
            <div class="live-bake-title-group">
                <h2 class="live-bake-title">@_bake.RecipeName</h2>
                <p class="live-bake-meta">
                    @_bake.StartedAt.ToLocalTime().ToString("d MMMM yyyy")
                    @if (_bake.AmbientTempC.HasValue)
                    {
                        <span class="meta-sep">·</span>
                        <span>Kitchen @_bake.AmbientTempC.Value.ToString("F0") °C</span>
                    }
                    @if (!string.IsNullOrEmpty(_bake.FlourBatch))
                    {
                        <span class="meta-sep">·</span>
                        <span>@_bake.FlourBatch</span>
                    }
                    @if (_bake.StarterName is not null)
                    {
                        <span class="meta-sep">·</span>
                        <span>🧫 @_bake.StarterName
                            @if (_bake.StarterFedHoursBefore.HasValue)
                            {
                                <span>(fed @((int)_bake.StarterFedHoursBefore.Value)h before)</span>
                            }
                        </span>
                    }
                    @if (_plannedTotalMin > 0)
                    {
                        <span class="meta-sep">·</span>
                        <span>Planned @FormatDuration(TimeSpan.FromMinutes(_plannedTotalMin))</span>
                    }
                </p>
                @if (_bake.HydrationPct.HasValue || _bake.TotalFlourGrams.HasValue)
                {
                    <p class="live-bake-formula">
                        @if (_bake.HydrationPct.HasValue)
                        {
                            <span>@_bake.HydrationPct.Value.ToString("F0")% hydration</span>
                        }
                        @if (_bake.TotalFlourGrams.HasValue)
                        {
                            <span class="meta-sep">·</span>
                            <span>@_bake.TotalFlourGrams.Value.ToString("F0") g flour</span>
                        }
                        @if (_bake.SaltPct.HasValue)
                        {
                            <span class="meta-sep">·</span>
                            <span>@_bake.SaltPct.Value.ToString("F1")% salt</span>
                        }
                        @if (_bake.InoculationPct.HasValue)
                        {
                            <span class="meta-sep">·</span>
                            <span>@_bake.InoculationPct.Value.ToString("F0")% inoculation</span>
                        }
                    </p>
                }
                <p class="live-bake-duration">
                    @if (_bake.EndedAt.HasValue)
                    {
                        <span class="duration-label">Total</span>
                        <span class="duration-value">@FormatDuration(_bake.EndedAt.Value - _bake.StartedAt)</span>
                    }
                    else if (_anyStarted)
                    {
                        <span class="duration-label">Elapsed</span>
                        <span class="duration-value">@FormatDuration(DateTimeOffset.UtcNow - _bake.StartedAt)</span>
                    }
                </p>
            </div>
        </div>

        @if (_notifications.Count > 0)
        {
            <div class="bake-notifications">
                @foreach (var n in _notifications.ToList())
                {
                    <div class="bake-notification">
                        <span class="bake-notification-text">@n</span>
                        <button class="bake-notification-dismiss"
                                @onclick="() => _notifications.Remove(n)"
                                title="Dismiss">×</button>
                    </div>
                }
            </div>
        }

        @if (!_anyStarted)
        {
            <div class="planning-view">
                <h3 class="section-title">Bake plan</h3>
                <PlanningGantt Steps="_bake.StepLogs" />
            </div>
        }

        <div class="step-list">
            @foreach (var step in _bake.StepLogs)
            {
                <StepCard Step="step"
                          MeasurementTypes="_bake.MeasurementTypes"
                          OnStart="HandleStart"
                          OnPause="HandlePause"
                          OnComplete="HandleComplete"
                          OnIncrease="HandleIncrease"
                          OnDecrease="HandleDecrease"
                          OnMeasurementSaved="RefreshBake" />
            }
        </div>

        <div class="bake-notes-section">
            <div class="bake-notes-header">
                <h3 class="section-title">Notes</h3>
                @if (_saveStatus is not null)
                {
                    <span class="notes-save-status @(_saveStatus == "Saving…" ? "saving" : "saved")">@_saveStatus</span>
                }
            </div>
            <textarea class="bake-notes-textarea"
                      placeholder="Add any notes about this bake…"
                      @bind="_notes"
                      @oninput="HandleNotesInput" />
        </div>

        <div class="bake-outcome-section">
            <div class="bake-outcome-header">
                <h3 class="section-title">Outcome</h3>
                <button class="btn-outcome-edit" @onclick="() => _showOutcomeSheet = true">
                    @(_bake.Outcome is null ? "Log outcome" : "Edit")
                </button>
            </div>
            @if (_bake.Outcome is { } o)
            {
                @if (o.IsBestLoaf)
                {
                    <span class="outcome-best-loaf">🏆 Best loaf</span>
                }
                @if (o.OverallScore.HasValue)
                {
                    <div class="outcome-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="@(i <= o.OverallScore.Value ? "star-filled" : "star-empty")">★</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(o.Tags))
                {
                    <div class="outcome-tags">
                        @foreach (var tag in o.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="outcome-tag">@tag</span>
                        }
                    </div>
                }
                @if (o.PhotoPath is not null)
                {
                    <img src="/uploads/@o.PhotoPath" class="outcome-photo" alt="Bake photo" />
                }
                <div class="outcome-chips">
                    @if (o.OvenSpringPct.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Oven spring</span><span class="oc-value">@o.OvenSpringPct.Value.ToString("F0")%</span></div>
                    }
                    @if (o.LoafHeightCm.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Loaf height</span><span class="oc-value">@o.LoafHeightCm.Value.ToString("F1") cm</span></div>
                    }
                    @if (o.InternalTempC.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Internal temp</span><span class="oc-value">@o.InternalTempC.Value.ToString("F1") °C</span></div>
                    }
                    @if (o.WeightLossPct.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Weight loss</span><span class="oc-value">@o.WeightLossPct.Value.ToString("F1")%</span></div>
                    }
                    @if (o.CrumbOpenness.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Crumb</span><span class="oc-value">@o.CrumbOpenness.Value/10</span></div>
                    }
                    @if (o.CrustScore.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Crust</span><span class="oc-value">@o.CrustScore.Value/10</span></div>
                    }
                    @if (o.TasteScore.HasValue)
                    {
                        <div class="outcome-chip"><span class="oc-label">Taste</span><span class="oc-value">@o.TasteScore.Value/10</span></div>
                    }
                </div>
            }
            else
            {
                <p class="outcome-empty-hint">Record measurements and scores after the bake to track your results over time.</p>
            }
        </div>

        @if (_bake.EndedAt.HasValue)
        {
            <StorageAdvisor Method="@_bake.Method" StarterActivity="@_bake.StarterActivity" />
        }

        <OutcomeSheet BakeId="Id"
                      ExistingOutcome="_bake.Outcome"
                      IsVisible="_showOutcomeSheet"
                      OnSaved="HandleOutcomeSaved"
                      OnCancelled="() => _showOutcomeSheet = false" />

    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private BakeDto?  _bake;
    private bool      _loading = true;
    private System.Threading.Timer? _ticker;
    private HubConnection? _hub;
    private readonly List<string> _notifications = [];

    private bool _soundEnabled = true;
    private readonly HashSet<int> _alreadyAlertedPlanned = [];
    private readonly HashSet<int> _alreadyAlertedMax     = [];
    private bool _showOutcomeSheet;

    private string? _notes;
    private string? _saveStatus;
    private System.Threading.Timer? _notesDebounceTicker;

    private bool _anyStarted =>
        _bake?.StepLogs.Any(l => l.Status != StepStatus.NotStarted) == true;

    private int _plannedTotalMin =>
        _bake?.StepLogs.Sum(l => l.PlannedDurationMin) ?? 0;

    private static string FormatDuration(TimeSpan span)
    {
        var h = (int)span.TotalHours;
        var m = span.Minutes;
        return h > 0 ? $"{h}h {m:D2}m" : $"{m}m";
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _bake    = await Http.GetFromJsonAsync<BakeDto>($"/api/bakes/{Id}");
        _notes   = _bake?.Notes;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _ticker = new System.Threading.Timer(
            _ => InvokeAsync(TickAsync), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(1));

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/bake"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<string>("FoldsReminder", msg => AddNotification("🕐 " + msg));
            _hub.On<string>("Bulk50Crossed", msg => AddNotification("📈 " + msg));
            _hub.On<string>("StepCompleted", msg => AddNotification("✓ " + msg));

            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinBake", Id);
        }
        catch
        {
            // Notifications are optional — degrade silently if hub is unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _ticker?.Dispose();
        _notesDebounceTicker?.Dispose();
        if (_hub is not null)
            await _hub.DisposeAsync();
    }

    private void AddNotification(string message)
    {
        _notifications.Insert(0, message);
        if (_notifications.Count > 5)
            _notifications.RemoveAt(_notifications.Count - 1);
        InvokeAsync(StateHasChanged);
    }

    // ── Tick + overrun alerts ────────────────────────────────────────────────

    private async Task TickAsync()
    {
        await CheckOverrunAlertsAsync();
        StateHasChanged();
    }

    private async Task CheckOverrunAlertsAsync()
    {
        if (_bake is null || !_soundEnabled) return;

        foreach (var step in _bake.StepLogs.Where(s => s.Status == StepStatus.Running))
        {
            if (step.StartedAt is null) continue;
            var elapsed = DateTimeOffset.UtcNow - step.StartedAt.Value;

            if (step.MaxDurationMin > 0
                && elapsed > TimeSpan.FromMinutes(step.MaxDurationMin)
                && _alreadyAlertedMax.Add(step.Id))
            {
                await JS.InvokeVoidAsync("breadAudio.warnOverMax");
            }
            else if (elapsed > TimeSpan.FromMinutes(step.PlannedDurationMin)
                && !_alreadyAlertedMax.Contains(step.Id)
                && _alreadyAlertedPlanned.Add(step.Id))
            {
                await JS.InvokeVoidAsync("breadAudio.warnOverPlanned");
            }
        }
    }

    // ── Notes auto-save ──────────────────────────────────────────────────────

    private void HandleNotesInput(ChangeEventArgs e)
    {
        _notes = e.Value?.ToString();
        _saveStatus = "Saving…";
        _notesDebounceTicker?.Dispose();
        _notesDebounceTicker = new System.Threading.Timer(
            _ => InvokeAsync(SaveNotesAsync), null,
            TimeSpan.FromMilliseconds(1200), Timeout.InfiniteTimeSpan);
    }

    private async Task SaveNotesAsync()
    {
        await Http.PatchAsJsonAsync($"/api/bakes/{Id}/notes", new { Notes = _notes });
        _saveStatus = "Saved";
        StateHasChanged();
        await Task.Delay(2000);
        _saveStatus = null;
        StateHasChanged();
    }

    // ── API handlers ─────────────────────────────────────────────────────────

    private async Task HandleStart(int id)
    {
        await Http.PostAsync($"/api/steplogs/{id}/start", null);
        await RefreshBake();
    }

    private async Task HandlePause(int id)
    {
        await Http.PostAsync($"/api/steplogs/{id}/pause", null);
        await RefreshBake();
    }

    private async Task HandleComplete(int id)
    {
        await Http.PostAsync($"/api/steplogs/{id}/complete", null);
        await RefreshBake();
    }

    private async Task HandleIncrease(int id)
    {
        var s = _bake!.StepLogs.First(l => l.Id == id);
        await Http.PatchAsync($"/api/steplogs/{id}/duration?deltaMin={s.StepMin}", null);
        await RefreshBake();
    }

    private async Task HandleDecrease(int id)
    {
        var s = _bake!.StepLogs.First(l => l.Id == id);
        await Http.PatchAsync($"/api/steplogs/{id}/duration?deltaMin={-s.StepMin}", null);
        await RefreshBake();
    }

    private async Task RefreshBake()
    {
        _bake = await Http.GetFromJsonAsync<BakeDto>($"/api/bakes/{Id}");
    }

    private async Task HandleOutcomeSaved()
    {
        _showOutcomeSheet = false;
        await RefreshBake();
    }
}
