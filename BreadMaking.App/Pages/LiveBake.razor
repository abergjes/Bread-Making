@page "/bake/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

@if (_loading)
{
    <div class="loading-screen">
        <div class="loading-icon">🍞</div>
        <p>Loading bake…</p>
    </div>
}
else if (_bake is null)
{
    <div class="live-bake-page">
        <p class="text-muted">Bake not found.</p>
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/")'>← Back to advisor</button>
    </div>
}
else
{
    <div class="live-bake-page">

        <div class="live-bake-header">
            <button class="back-btn" @onclick='() => Nav.NavigateTo("/")'>← Home</button>
            <button class="back-btn" style="margin-left:auto" @onclick='() => Nav.NavigateTo("/history")'>History →</button>
            <div class="live-bake-title-group">
                <h2 class="live-bake-title">@_bake.RecipeName</h2>
                <p class="live-bake-meta">
                    @_bake.StartedAt.ToLocalTime().ToString("d MMMM yyyy")
                    @if (_bake.AmbientTempC.HasValue)
                    {
                        <span class="meta-sep">·</span>
                        <span>Kitchen @_bake.AmbientTempC.Value.ToString("F0") °C</span>
                    }
                    @if (!string.IsNullOrEmpty(_bake.FlourBatch))
                    {
                        <span class="meta-sep">·</span>
                        <span>@_bake.FlourBatch</span>
                    }
                </p>
            </div>
        </div>

        @if (_notifications.Count > 0)
        {
            <div class="bake-notifications">
                @foreach (var n in _notifications.ToList())
                {
                    <div class="bake-notification">
                        <span class="bake-notification-text">@n</span>
                        <button class="bake-notification-dismiss"
                                @onclick="() => _notifications.Remove(n)"
                                title="Dismiss">×</button>
                    </div>
                }
            </div>
        }

        @if (!_anyStarted)
        {
            <div class="planning-view">
                <h3 class="section-title">Bake plan</h3>
                <PlanningGantt Steps="_bake.StepLogs" />
            </div>
        }

        <div class="step-list">
            @foreach (var step in _bake.StepLogs)
            {
                <StepCard Step="step"
                          MeasurementTypes="_bake.MeasurementTypes"
                          OnStart="HandleStart"
                          OnPause="HandlePause"
                          OnComplete="HandleComplete"
                          OnIncrease="HandleIncrease"
                          OnDecrease="HandleDecrease"
                          OnMeasurementSaved="RefreshBake" />
            }
        </div>

    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private BakeDto?  _bake;
    private bool      _loading = true;
    private System.Threading.Timer? _ticker;
    private HubConnection? _hub;
    private readonly List<string> _notifications = [];

    private bool _anyStarted =>
        _bake?.StepLogs.Any(l => l.Status != StepStatus.NotStarted) == true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _bake    = await Http.GetFromJsonAsync<BakeDto>($"/api/bakes/{Id}");
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _ticker = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(1));

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/bake"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<string>("FoldsReminder", msg => AddNotification("🕐 " + msg));
            _hub.On<string>("Bulk50Crossed", msg => AddNotification("📈 " + msg));
            _hub.On<string>("StepCompleted", msg => AddNotification("✓ " + msg));

            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinBake", Id);
        }
        catch
        {
            // Notifications are optional — degrade silently if hub is unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _ticker?.Dispose();
        if (_hub is not null)
            await _hub.DisposeAsync();
    }

    private void AddNotification(string message)
    {
        _notifications.Insert(0, message);
        if (_notifications.Count > 5)
            _notifications.RemoveAt(_notifications.Count - 1);
        InvokeAsync(StateHasChanged);
    }

    // ── API handlers ─────────────────────────────────────────────────────────

    private async Task HandleStart(int id)
    {
        await Http.PostAsync($"/api/steplogs/{id}/start", null);
        await RefreshBake();
    }

    private async Task HandlePause(int id)
    {
        await Http.PostAsync($"/api/steplogs/{id}/pause", null);
        await RefreshBake();
    }

    private async Task HandleComplete(int id)
    {
        await Http.PostAsync($"/api/steplogs/{id}/complete", null);
        await RefreshBake();
    }

    private async Task HandleIncrease(int id)
    {
        var s = _bake!.StepLogs.First(l => l.Id == id);
        await Http.PatchAsync($"/api/steplogs/{id}/duration?deltaMin={s.StepMin}", null);
        await RefreshBake();
    }

    private async Task HandleDecrease(int id)
    {
        var s = _bake!.StepLogs.First(l => l.Id == id);
        await Http.PatchAsync($"/api/steplogs/{id}/duration?deltaMin={-s.StepMin}", null);
        await RefreshBake();
    }

    private async Task RefreshBake()
    {
        _bake = await Http.GetFromJsonAsync<BakeDto>($"/api/bakes/{Id}");
    }
}
