@page "/inclusions"
@inject NavigationManager Nav

<div class="incl-page">

    <div class="incl-header">
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/history")'>← History</button>
        <div class="incl-title-group">
            <h2 class="incl-title">Inclusions & Add-ins</h2>
            <p class="incl-subtitle">How to prepare, time, and quantity-adjust seeds, fruits, nuts, and savoury add-ins</p>
        </div>
    </div>

    <div class="incl-tabs">
        @foreach (var t in _tabs)
        {
            <button class="incl-tab @(_activeTab == t.Id ? "incl-tab--active" : "")"
                    @onclick="() => _activeTab = t.Id">@t.Label</button>
        }
    </div>

    @if (_activeTab == "principles")
    {
        <section class="incl-section">
            <p class="incl-intro">
                Inclusions are added after bulk structure is established — too early and they cut gluten strands;
                too late and they tear a shaped loaf. As a rule: add at the lamination fold, or fold in during
                the first 30 minutes of bulk before significant gluten has built up.
            </p>

            <div class="incl-principle-grid">
                @foreach (var p in _principles)
                {
                    <div class="incl-principle-card">
                        <span class="incl-principle-icon">@p.Icon</span>
                        <div class="incl-principle-name">@p.Name</div>
                        <p class="incl-principle-desc">@p.Description</p>
                    </div>
                }
            </div>

            <div class="incl-timing-card">
                <div class="incl-timing-title">When to add inclusions during the bake process</div>
                <div class="incl-timeline">
                    @foreach (var s in _addTimings)
                    {
                        <div class="incl-tl-item incl-tl-item--@s.RecommendClass">
                            <div class="incl-tl-dot"></div>
                            <div class="incl-tl-body">
                                <div class="incl-tl-label">@s.Stage</div>
                                <div class="incl-tl-rec incl-tl-rec--@s.RecommendClass">@s.Recommendation</div>
                                <div class="incl-tl-text">@s.Detail</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="incl-hydration-card">
                <div class="incl-hydration-title">Hydration adjustment by inclusion type</div>
                <p class="incl-hydration-intro">
                    Dry inclusions (unsoaked seeds, raw nuts, dry fruits) absorb water from the dough during baking,
                    tightening the crumb and drying the interior. Soak them first, or reduce overall hydration
                    by the absorption amount.
                </p>
                <div class="incl-hydration-grid">
                    @foreach (var row in _hydrationAdjustments)
                    {
                        <div class="incl-hydration-row">
                            <span class="incl-hydration-type">@row.Type</span>
                            <span class="incl-hydration-adj incl-hydration-adj--@row.AdjClass">@row.Adjustment</span>
                            <span class="incl-hydration-note">@row.Note</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (_activeTab == "seeds")
    {
        <section class="incl-section">
            <p class="incl-intro">
                Seeds add crunch, nutrition, and flavour without significantly disrupting gluten structure.
                Toast most seeds before adding — it removes moisture and intensifies flavour compounds.
                Soak dense seeds (flax, hemp) to prevent moisture draw from the crumb.
            </p>

            <div class="incl-item-grid">
                @foreach (var item in _seeds)
                {
                    <div class="incl-item-card">
                        <div class="incl-item-header">
                            <span class="incl-item-icon">@item.Icon</span>
                            <div>
                                <div class="incl-item-name">@item.Name</div>
                                <div class="incl-item-qty">@item.Quantity</div>
                            </div>
                            <div class="incl-item-tags">
                                <span class="incl-tag incl-tag--@item.PrepClass">@item.PrepLabel</span>
                                <span class="incl-tag incl-tag--timing">@item.When</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Prep))
                        {
                            <div class="incl-prep-row">
                                <span class="incl-prep-label">Prep:</span> @item.Prep
                            </div>
                        }
                        <p class="incl-item-desc">@item.Description</p>
                        <div class="incl-item-pairs">
                            @foreach (var pair in item.Pairs)
                            {
                                <span class="incl-pair-chip">@pair</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Tip))
                        {
                            <div class="incl-item-tip">💡 @item.Tip</div>
                        }
                    </div>
                }
            </div>
        </section>
    }
    else if (_activeTab == "fruits")
    {
        <section class="incl-section">
            <p class="incl-intro">
                Dried fruits add sugar directly to the crumb — this accelerates fermentation and can cause
                localised over-proof around each piece. Keep quantities moderate (15–25%) and add late in bulk
                or at lamination. Fresh fruits add significant water; reduce dough hydration to compensate.
            </p>

            <div class="incl-item-grid">
                @foreach (var item in _fruitsAndNuts)
                {
                    <div class="incl-item-card">
                        <div class="incl-item-header">
                            <span class="incl-item-icon">@item.Icon</span>
                            <div>
                                <div class="incl-item-name">@item.Name</div>
                                <div class="incl-item-qty">@item.Quantity</div>
                            </div>
                            <div class="incl-item-tags">
                                <span class="incl-tag incl-tag--@item.PrepClass">@item.PrepLabel</span>
                                <span class="incl-tag incl-tag--timing">@item.When</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Prep))
                        {
                            <div class="incl-prep-row">
                                <span class="incl-prep-label">Prep:</span> @item.Prep
                            </div>
                        }
                        <p class="incl-item-desc">@item.Description</p>
                        <div class="incl-item-pairs">
                            @foreach (var pair in item.Pairs)
                            {
                                <span class="incl-pair-chip">@pair</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Tip))
                        {
                            <div class="incl-item-tip">💡 @item.Tip</div>
                        }
                    </div>
                }
            </div>
        </section>
    }
    else if (_activeTab == "savoury")
    {
        <section class="incl-section">
            <p class="incl-intro">
                Savoury inclusions — olives, cheese, herbs, alliums — transform a plain loaf into a centrepiece.
                Fats from cheese and olives weaken gluten slightly; compensate with tighter shaping.
                Wet ingredients (roasted garlic, caramelised onion) add moisture; pat dry before adding.
            </p>

            <div class="incl-item-grid">
                @foreach (var item in _savoury)
                {
                    <div class="incl-item-card">
                        <div class="incl-item-header">
                            <span class="incl-item-icon">@item.Icon</span>
                            <div>
                                <div class="incl-item-name">@item.Name</div>
                                <div class="incl-item-qty">@item.Quantity</div>
                            </div>
                            <div class="incl-item-tags">
                                <span class="incl-tag incl-tag--@item.PrepClass">@item.PrepLabel</span>
                                <span class="incl-tag incl-tag--timing">@item.When</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Prep))
                        {
                            <div class="incl-prep-row">
                                <span class="incl-prep-label">Prep:</span> @item.Prep
                            </div>
                        }
                        <p class="incl-item-desc">@item.Description</p>
                        <div class="incl-item-pairs">
                            @foreach (var pair in item.Pairs)
                            {
                                <span class="incl-pair-chip">@pair</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Tip))
                        {
                            <div class="incl-item-tip">💡 @item.Tip</div>
                        }
                    </div>
                }
            </div>

            <div class="incl-fat-warning">
                <span>⚠️</span>
                <div>
                    <strong>Fat inclusions and gluten:</strong> Cheese, olives, and oily herbs all introduce fat into
                    the dough matrix. Fat coats gluten strands and reduces extensibility. Add these inclusions as late
                    as possible (lamination or final fold), work quickly during shaping, and expect a slightly denser
                    crumb than an equivalent plain loaf. The flavour trade-off is overwhelmingly worth it.
                </div>
            </div>
        </section>
    }

</div>

