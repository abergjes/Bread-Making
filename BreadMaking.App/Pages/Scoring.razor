@page "/scoring"
@inject NavigationManager Nav

<div class="score-page">

    <div class="score-header">
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/history")'>← History</button>
        <div class="score-title-group">
            <h2 class="score-title">Scoring & Ear Guide</h2>
            <p class="score-subtitle">Blade angles, depth, patterns, and why your ear collapsed</p>
        </div>
    </div>

    <div class="score-tabs">
        @foreach (var t in _tabs)
        {
            <button class="score-tab @(_activeTab == t.Id ? "score-tab--active" : "")"
                    @onclick="() => _activeTab = t.Id">@t.Label</button>
        }
    </div>

    @if (_activeTab == "fundamentals")
    {
        <section class="score-section">
            <p class="score-intro">
                Scoring controls where the loaf expands during oven spring. A well-placed cut lets the baker
                direct the burst rather than letting the oven decide — usually at a seam, where the ear
                is weakest and least attractive. Score cold dough, score decisively, and score last.
            </p>

            <div class="score-blade-grid">
                @foreach (var b in _blades)
                {
                    <div class="score-blade-card">
                        <div class="score-blade-header">
                            <span class="score-blade-icon">@b.Icon</span>
                            <div>
                                <div class="score-blade-name">@b.Name</div>
                                <div class="score-blade-sub">@b.Subtitle</div>
                            </div>
                            <span class="score-blade-tag score-blade-tag--@b.LevelClass">@b.Level</span>
                        </div>
                        <p class="score-blade-desc">@b.Description</p>
                        <div class="score-blade-pros-cons">
                            <div>
                                <div class="score-mini-title">Pros</div>
                                @foreach (var p in b.Pros) { <div class="score-pro">✓ @p</div> }
                            </div>
                            <div>
                                <div class="score-mini-title">Cons</div>
                                @foreach (var c in b.Cons) { <div class="score-con">✗ @c</div> }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="score-angle-card">
                <div class="score-angle-title">Blade angle & depth reference</div>
                <div class="score-angle-grid">
                    @foreach (var a in _angles)
                    {
                        <div class="score-angle-row score-angle-row--@a.ResultClass">
                            <div class="score-angle-deg">@a.Angle</div>
                            <div class="score-angle-depth">@a.Depth</div>
                            <div class="score-angle-result">@a.Result</div>
                            <div class="score-angle-use">@a.BestFor</div>
                        </div>
                    }
                </div>
                <div class="score-angle-legend">
                    <span class="score-ang-dot score-ang-dot--ear"></span> Ear
                    <span class="score-ang-dot score-ang-dot--split"></span> Split / bloom
                    <span class="score-ang-dot score-ang-dot--dock"></span> Dock (no rise)
                </div>
            </div>

            <div class="score-timing-card">
                <div class="score-timing-title">When to score</div>
                <div class="score-timing-grid">
                    @foreach (var s in _scoringSequence)
                    {
                        <div class="score-seq-item score-seq-item--@s.TypeClass">
                            <span class="score-seq-icon">@s.Icon</span>
                            <div>
                                <div class="score-seq-label">@s.Label</div>
                                <div class="score-seq-text">@s.Text</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="score-tips-strip">
                @foreach (var tip in _fundamentalTips)
                {
                    <div class="score-tip-item">
                        <span>@tip.Icon</span>
                        <div>
                            <strong>@tip.Label</strong> — @tip.Text
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    else if (_activeTab == "patterns")
    {
        <section class="score-section">
            <p class="score-intro">
                Pattern choice should follow loaf shape and crumb intent. Functional scores control expansion;
                decorative scores add visual appeal but must still be deep enough to guide spring. Always
                include at least one functional score — decoration alone rarely prevents blowouts.
            </p>

            <div class="score-pattern-grid">
                @foreach (var p in _patterns)
                {
                    <div class="score-pattern-card">
                        <div class="score-pattern-diagram">@p.Diagram</div>
                        <div class="score-pattern-body">
                            <div class="score-pattern-name">@p.Name</div>
                            <div class="score-pattern-meta">
                                <span class="score-diff score-diff--@p.DiffClass">@p.Difficulty</span>
                                <span class="score-pattern-shape">@p.BestShape</span>
                            </div>
                            <p class="score-pattern-desc">@p.Description</p>
                            <div class="score-pattern-how">
                                <div class="score-mini-title">How to cut</div>
                                @foreach (var step in p.Steps)
                                {
                                    <div class="score-pattern-step">@step</div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Tip))
                            {
                                <div class="score-pattern-tip">💡 @p.Tip</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="score-surface-card">
                <div class="score-surface-title">Surface preparation by hydration</div>
                <div class="score-surface-grid">
                    @foreach (var h in _hydrationSurfaces)
                    {
                        <div class="score-surface-row">
                            <span class="score-surface-range">@h.Range</span>
                            <span class="score-surface-tag score-surface-tag--@h.TagClass">@h.Label</span>
                            <span class="score-surface-text">@h.Text</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (_activeTab == "troubleshoot")
    {
        <section class="score-section">
            <p class="score-intro">
                Most scoring failures trace back to three root causes: under-cold dough, a dull blade, or
                incorrect angle. Identify the symptom and work backwards to the cause before changing
                anything else.
            </p>

            <div class="score-trouble-grid">
                @foreach (var t in _troubles)
                {
                    <div class="score-trouble-card">
                        <div class="score-trouble-header">
                            <span class="score-trouble-icon">@t.Icon</span>
                            <div>
                                <div class="score-trouble-symptom">@t.Symptom</div>
                                <span class="score-trouble-sev score-trouble-sev--@t.SevClass">@t.Severity</span>
                            </div>
                        </div>
                        <div class="score-trouble-body">
                            <div>
                                <div class="score-mini-title">Likely causes</div>
                                <ul class="score-cause-list">
                                    @foreach (var c in t.Causes) { <li>@c</li> }
                                </ul>
                            </div>
                            <div>
                                <div class="score-mini-title">Fixes</div>
                                <ul class="score-fix-list">
                                    @foreach (var f in t.Fixes) { <li>@f</li> }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

</div>

@code {
