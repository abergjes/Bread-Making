@page "/history"
@inject NavigationManager Nav
@inject HttpClient Http
@inject CloneBakeState CloneState

<div class="history-page">

    <div class="history-header">
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/")'>← Home</button>
        <div class="history-title-group">
            <h2 class="history-title">Bake history</h2>
            <p class="history-subtitle">Track how your results improve over time</p>
        </div>
        <div class="history-header-actions">
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/starter")'>
                🧫 Starters
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/calculators")'>
                🧮 Calculators
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/safety")'>
                🧺 Safety
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/kit")'>
                🔧 Kit
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/history/analytics")'>
                📊 Analytics
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/breads")'>
                🌍 World Breads
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/finishing")'>
                🖌️ Finishing
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/flavour")'>
                🔬 Flavour Science
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/nutrition")'>
                🧪 Nutrition
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/specialty")'>
                🌿 Specialty
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/flourspec")'>
                🫧 Flour Spec
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/troubleshoot")'>
                🔍 Troubleshoot
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/glossary")'>
                📖 Glossary
            </button>
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/formulas")'>
                📝 Formula Book
            </button>
            <button class="btn-compare" @onclick='() => Nav.NavigateTo("/history/compare")'>
                Compare grains ▶
            </button>
        </div>
    </div>

    <div class="history-section">
        <h3 class="section-title">Reproducibility over time</h3>
        <p class="history-hint">
            As you log more bakes the scatter narrows and your results converge on target.
        </p>
        <RunChart />
    </div>

    @if (_loading)
    {
        <p class="comparison-loading">Loading bakes…</p>
    }
    else if (_allBakes.Count == 0)
    {
        <div class="history-empty-note">
            <p>Past bakes will appear here once you start your first bake.</p>
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/")'>Go to advisor</button>
        </div>
    }
    else
    {
        <div class="history-filters">
            <select class="filter-select" @bind="_grainFilter">
                <option value="">All grains</option>
                @foreach (var grain in _grains)
                {
                    <option value="@grain">@grain</option>
                }
            </select>
            <select class="filter-select" @bind="_methodFilter">
                <option value="">All methods</option>
                <option value="Autolyse">Autolyse</option>
                <option value="Fermentolyse">Fermentolyse</option>
                <option value="Other">Other</option>
                <option value="Steamed">Steamed</option>
                <option value="Enriched">Enriched</option>
                <option value="Commercial">Commercial</option>
            </select>
            <button class="filter-toggle @(_bestOnly ? "filter-toggle-active" : "")"
                    @onclick="() => _bestOnly = !_bestOnly">
                🏆 Best loaves only
            </button>
        </div>

        @if (!FilteredBakes.Any())
        {
            <p class="history-hint" style="text-align:center;padding:24px 0">
                No bakes match the selected filters.
            </p>
        }
        else
        {
            <div class="bake-list">
                @foreach (var bake in FilteredBakes)
                {
                    <div class="bake-item">
                        <div class="bake-item-header">
                            <span class="bake-grain-emoji">@GrainEmoji(bake.GrainName)</span>
                            <div class="bake-item-info">
                                <span class="bake-item-title">@bake.GrainName · @bake.Method</span>
                                <span class="bake-item-date">
                                    @bake.StartedAt.ToLocalTime().ToString("d MMM yyyy")
                                    @if (!string.IsNullOrEmpty(bake.FlourBatch))
                                    {
                                        <span class="bake-batch"> · @bake.FlourBatch</span>
                                    }
                                    @if (bake.HydrationPct.HasValue)
                                    {
                                        <span class="bake-batch"> · @bake.HydrationPct.Value.ToString("F0")%</span>
                                    }
                                </span>
                            </div>
                            <div class="bake-item-badges">
                                @if (bake.IsBestLoaf)
                                {
                                    <span class="bake-best-badge" title="Best loaf">🏆</span>
                                }
                                @if (bake.OverallScore.HasValue)
                                {
                                    <span class="bake-rating-badge">@bake.OverallScore★</span>
                                }
                                @if (!string.IsNullOrEmpty(bake.CrumbNotes))
                                {
                                    <span class="bake-crumb-badge" title="@bake.CrumbNotes">📋</span>
                                }
                                @if (bake.HasOutcome)
                                {
                                    <span class="bake-outcome-check" title="Outcome recorded">✓</span>
                                }
                            </div>
                        </div>

                        @if (bake.OvenSpringPct.HasValue || bake.CrumbOpenness.HasValue)
                        {
                            <div class="bake-item-meta">
                                @if (bake.OvenSpringPct.HasValue)
                                {
                                    <span>Oven spring @bake.OvenSpringPct.Value.ToString("F0")%</span>
                                }
                                @if (bake.CrumbOpenness.HasValue)
                                {
                                    <span>Crumb @bake.CrumbOpenness.Value/10</span>
                                }
                            </div>
                        }

                        @if (bake.StarterName is not null)
                        {
                            <div class="bake-starter-badge">
                                🧫 @bake.StarterName
                                @if (bake.StarterFedHoursBefore.HasValue)
                                {
                                    <span class="bake-starter-age">· fed @FormatHours(bake.StarterFedHoursBefore.Value) before bake</span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(bake.Tags))
                        {
                            <div class="bake-item-tags">
                                @foreach (var tag in bake.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="bake-tag">@tag</span>
                                }
                            </div>
                        }

                        <div class="bake-item-actions">
                            <button class="btn-bake-action btn-view"
                                    @onclick='() => Nav.NavigateTo($"/bake/{bake.Id}")'>
                                View
                            </button>
                            <button class="btn-bake-action btn-similar"
                                    @onclick="() => StartSimilar(bake.Id)">
                                Start similar
                            </button>
                            <a class="btn-bake-action btn-export"
                               href="/api/bakes/@bake.Id/export?format=csv">CSV</a>
                            <a class="btn-bake-action btn-export"
                               href="/api/bakes/@bake.Id/export?format=json">JSON</a>
                        </div>
                    </div>
                }
            </div>
        }
    }

</div>

@code {
    private bool _loading = true;
    private List<BakeListItemDto> _allBakes = [];
    private string _grainFilter  = "";
    private string _methodFilter = "";
    private bool   _bestOnly     = false;

    private IEnumerable<string> _grains => _allBakes
        .Select(b => b.GrainName)
        .Distinct()
        .OrderBy(g => g);

    private IEnumerable<BakeListItemDto> FilteredBakes => _allBakes
        .Where(b => string.IsNullOrEmpty(_grainFilter)  || b.GrainName == _grainFilter)
        .Where(b => string.IsNullOrEmpty(_methodFilter) || b.Method.ToString() == _methodFilter)
        .Where(b => !_bestOnly || b.IsBestLoaf);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allBakes = await Http.GetFromJsonAsync<List<BakeListItemDto>>("/api/bakes") ?? [];
        }
        finally { _loading = false; }
    }

    private async Task StartSimilar(int bakeId)
    {
        var req = await Http.GetFromJsonAsync<StartBakeRequest>($"/api/bakes/{bakeId}/inputs");
        if (req is null) return;
        CloneState.Set(req);
        Nav.NavigateTo("/");
    }

    private static string FormatHours(double h) =>
        h < 1   ? "< 1h" :
        h < 24  ? $"{(int)h}h" :
                  $"{(int)(h / 24)}d";

    private static string GrainEmoji(string grain) => grain switch
    {
        "Modern wheat" or "Whole grain" => "🌾",
        "Rye"                           => "🌿",
        "Spelt"                         => "🌱",
        "Einkorn"                       => "⚜️",
        "Emmer (farro)"                 => "🌿",
        "Kamut (khorasan)"              => "🌰",
        "Teff" or "Sorghum"             => "🫘",
        "Low-protein wheat"             => "🥟",
        _                               => "🌾",
    };
}
