    private record FeedFlour(string Icon, string Name, string Description, string Tag, string TagClass);
    private readonly FeedFlour[] _feedFlours =
    [
        new("⚪", "White bread flour (12–13% protein)",
            "The most neutral choice. Supports a large, consistent yeast population with minimal enzyme interference. Good for establishing and maintaining a reliable culture.",
            "Standard", "std"),
