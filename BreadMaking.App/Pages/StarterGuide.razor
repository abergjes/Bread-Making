    private record StarterTrouble(string Icon, string Symptom, string Severity, string SevClass,
        string[] Causes, string[] Fixes);

    private readonly StarterTrouble[] _troubles =
    [
        new("🐌", "Not rising at all after feeding", "Urgent", "high",
            ["Starter is brand new (< 7 days old) — normal; patience needed",
             "Kitchen too cold (below 18 °C) — yeast is dormant, not dead",
