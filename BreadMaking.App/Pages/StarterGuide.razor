        new("🥛", "Unbleached AP flour",
            "Similar to bread flour with slightly less protein. Works well for lower-hydration (stiff) levain builds. Produces a slightly milder, creamier flavour.",
            "Good", "std"),
        new("❌", "Bleached flour",
            "Chemical bleaching destroys natural microorganisms and enzyme activity. Avoid for sourdough maintenance — the culture will weaken over successive feeds.",
            "Avoid", "avoid"),
        new("❌", "Self-raising flour",
            "Contains added baking powder and salt, both of which inhibit yeast and bacteria. Never use for starter maintenance.",
            "Never use", "avoid"),
    ];

    private record MaintenanceSchedule(string Name, string Frequency, string Description);
    private readonly MaintenanceSchedule[] _maintenanceSchedules =
    [
        new("Counter maintenance",
            "Feed once or twice daily",
            "Active starter left at room temperature needs feeding every 12–24 h to prevent collapse. Best for bakers baking 3+ times per week. Use a 1:2:2 or 1:5:5 ratio depending on kitchen temperature."),
        new("Refrigerator storage",
            "Feed once per week",
            "A fed starter can be refrigerated immediately and stored for up to 2 weeks without attention. Remove 24–48 h before baking, discard most of it, and feed twice at room temperature before building your levain."),
        new("Long-term storage (dried)",
            "Revive every 6–12 months",
            "Spread active starter thinly on parchment and dry at room temperature for 24–48 h. Crumble into flakes and store in an airtight container indefinitely. Rehydrate with warm water and flour and feed daily for 3–5 days to revive."),
